{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "description": "gha-runner: ARC disables runner self-update and GitHub rejects stale runner versions (exit 7 wedges the scale set), so track actions/runner releases",
      "customType": "regex",
      "managerFilePatterns": ["/^images/gha-runner/(image\\.toml|Dockerfile)$/"],
      "matchStrings": [
        "RUNNER_VERSION = \"(?<currentValue>[^\"]+)\"",
        "ARG RUNNER_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "actions/runner",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "description": "proton-bridge: track Bridge tags and their commit SHA (the Dockerfile verifies the cloned tag resolves to it)",
      "customType": "regex",
      "managerFilePatterns": ["/^images/proton-bridge/image\\.toml$/"],
      "matchStrings": [
        "ENV_PROTONMAIL_BRIDGE_VERSION = \"(?<currentValue>v[^\"]+)\", ENV_PROTONMAIL_BRIDGE_COMMIT = \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "depNameTemplate": "ProtonMail/proton-bridge",
      "datasourceTemplate": "github-tags"
    },
    {
      "description": "proton-bridge: keep the published image version (no 'v' prefix) in step with the build arg",
      "customType": "regex",
      "managerFilePatterns": ["/^images/proton-bridge/image\\.toml$/"],
      "matchStrings": ["\\nversion = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "ProtonMail/proton-bridge",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge runner bumps: an unmerged one breaks the cluster's runners within weeks",
      "matchPackageNames": ["actions/runner"],
      "automerge": true
    },
    {
      "description": "Not automerged: Bridge bumps can change the gRPC API the exporter relies on, so review the PR build. Grouped so version and build arg land in one PR",
      "matchPackageNames": ["ProtonMail/proton-bridge"],
      "groupName": "proton-bridge"
    }
  ]
}
